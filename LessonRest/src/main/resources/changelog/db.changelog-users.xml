<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- ✅ tbl_roles + BIGSERIAL + dbms="postgresql" -->
    <changeSet id="1" author="popkov" dbms="postgresql">
        <createTable tableName="tbl_roles" schemaName="distcomp">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tbl_roles"/>
            </column>
            <column name="name" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
        </createTable>
    </changeSet>

    <!-- ✅ tbl_users + BIGSERIAL + FK к tbl_roles -->
    <changeSet id="2" author="popkov" dbms="postgresql">
        <createTable tableName="tbl_users" schemaName="distcomp">
            <column name="id" type="BIGSERIAL">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tbl_users"/>
            </column>
            <column name="username" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
            <column name="role_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- ✅ FK к tbl_roles (а не roles!) -->
        <addForeignKeyConstraint
                baseTableName="tbl_users"
                baseTableSchemaName="distcomp"
                baseColumnNames="role_id"
                referencedTableName="tbl_roles"
                referencedTableSchemaName="distcomp"
                referencedColumnNames="id"
                constraintName="fk_tbl_users_role"/>
    </changeSet>

</databaseChangeLog>