<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.27.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- Создание схемы -->

    <changeSet id="0" author="popkov" dbms="postgresql">
        <sql dbms="postgresql">
            CREATE SCHEMA IF NOT EXISTS distcomp;
        </sql>
    </changeSet>

    <!-- Таблица редакторов -->
    <changeSet id="1" author="popkov" dbms="postgresql">
        <createTable tableName="tbl_editors" schemaName="distcomp">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tbl_editors"/>
            </column>
            <column name="login" type="VARCHAR(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="password" type="VARCHAR(128)">
                <constraints nullable="false"/>
            </column>
            <column name="firstname" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
            <column name="lastname" type="VARCHAR(64)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Таблица новостей -->
    <changeSet id="2" author="popkov" dbms="postgresql">
        <createTable tableName="tbl_news" schemaName="distcomp">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tbl_news"/>
            </column>
            <column name="title" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="modified" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="editorId" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="tbl_news"
                baseTableSchemaName="distcomp"
                baseColumnNames="editorId"
                referencedTableName="tbl_editors"
                referencedTableSchemaName="distcomp"
                referencedColumnNames="id"
                constraintName="fk_news_editor"/>
    </changeSet>

    <!-- Таблица стикеров -->
    <changeSet id="3" author="popkov" dbms="postgresql">
        <createTable tableName="tbl_stickers" schemaName="distcomp">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tbl_stickers"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="color" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Таблица уведомлений -->
    <changeSet id="4" author="popkov" dbms="postgresql">
        <createTable tableName="tbl_notices" schemaName="distcomp">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pk_tbl_notices"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="newsId" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="tbl_notices"
                baseTableSchemaName="distcomp"
                baseColumnNames="newsId"
                referencedTableName="tbl_news"
                referencedTableSchemaName="distcomp"
                referencedColumnNames="id"
                constraintName="fk_notice_news"/>
    </changeSet>

    <!-- Многие ко многим: news <-> stickers -->
    <changeSet id="5" author="popkov" dbms="postgresql">
        <createTable tableName="tbl_news_stickers" schemaName="distcomp">
            <column name="news_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="sticker_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>ALTER TABLE distcomp.tbl_news_stickers ADD PRIMARY KEY (news_id, sticker_id)</sql>
        <addForeignKeyConstraint
                baseTableName="tbl_news_stickers"
                baseTableSchemaName="distcomp"
                baseColumnNames="news_id"
                referencedTableName="tbl_news"
                referencedTableSchemaName="distcomp"
                referencedColumnNames="id"
                constraintName="fk_news_stickers_news"/>
        <addForeignKeyConstraint
                baseTableName="tbl_news_stickers"
                baseTableSchemaName="distcomp"
                baseColumnNames="sticker_id"
                referencedTableName="tbl_stickers"
                referencedTableSchemaName="distcomp"
                referencedColumnNames="id"
                constraintName="fk_news_stickers_sticker"/>
    </changeSet>

    <!-- Подключение пользовательских миграций -->
    <include file="classpath:/changelog/db.changelog-users.xml" relativeToChangelogFile="false"/>

</databaseChangeLog>